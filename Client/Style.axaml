<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


        <Style Selector="StackPanel.esq">
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="10,0,0,5" />
        </Style>

        <Style Selector="Image#userD">
            <Setter Property="Width" Value="60" />
            <Setter Property="Height" Value="60" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Border.mei">
            <Setter Property="Margin" Value="0,60,0,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Height" Value="450" />
        </Style>

        <Style Selector="StackPanel.cabecalho">
            <Setter Property="Height" Value="100" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style Selector="TextBlock#title">
            <Setter Property="FontFamily" Value="avares://Client/Assets/LSB.ttf#League Spartan" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,50,0,0" />
            <Setter Property="FontSize" Value="72" />
            <Setter Property="Foreground" Value="#000000" />
        </Style>

        <Style Selector="TextBlock#title2">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="36" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="Margin" Value="200,0,0,0" />
        </Style>

        <Style Selector="ComboBox#combo">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Width" Value="400" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="Background" Value="#393939" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontFamily" Value="avares://Client/Assets/LSV.ttf#League Spartan" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="StackPanel.dir">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>

        <Style Selector="Image#NotC">
            <Setter Property="Width" Value="60" />
            <Setter Property="Height" Value="60" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="TextBlock#NotT">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="#1e1b1b" />
            <Setter Property="FontFamily" Value="avares://Client/Assets/LSB.ttf#League Spartan" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
</Styles>